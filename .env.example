# Copy this file to .env (gitignored — never commit real credentials) and
# fill in real values to enable the Integrations tab's "Login" buttons in
# local development builds. See README.md's "Connecting GitHub/Slack/
# Linear" section for exactly how to register an OAuth application with
# each provider and what to put here.
#
# In CI, these same four names are supplied as GitHub Actions repo
# secrets instead of a .env file — see README.md and
# .github/workflows/ci.yml.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
LINEAR_CLIENT_ID=
